{
    "manifest_version": 3,
    "name": "__MSG_name__",
    "short_name": "__MSG_short_name__",
    "version": "1.1.1",
    "description": "__MSG_description__",
    "chrome_url_overrides": {
        "newtab": "index.html"
    },
    "permissions": [
        "storage",
        "search",
        "favicon"
    ],
    "host_permissions": [
        "https://svgl.app/*"
    ],
    "icons": {
        "16": "icon-16.png",
        "32": "icon-32.png",
        "48": "icon-48.png",
        "128": "icon-128.png"
    },
    "optional_permissions": [
        "topSites"
    ],
    "optional_host_permissions": [
        "https://*/*",
        "http://*/*",
        "file:///etc/chromium/policies/*"
    ],
    "default_locale": "en"
}
