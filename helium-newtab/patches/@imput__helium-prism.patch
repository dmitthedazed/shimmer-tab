+// Shimmer Tab: its Animation speed setting multiplies the intro's and the speed-up's
+// timings by globalThis.__shimmerMotion (1 / speed) and divides the idle wave's speeds
+// by it, read when they are used.
+var withMotion = function (timings) {
+    Object.keys(timings).forEach(function (key) {
+        var base = timings[key];
+        if (/delay|duration|stagger/i.test(key)) {
+            Object.defineProperty(timings, key, {
+                get: function () { return base * (globalThis.__shimmerMotion || 1); },
+            });
+        }
+        else if (/speed$/i.test(key)) {
+            Object.defineProperty(timings, key, {
+                get: function () { return base / (globalThis.__shimmerMotion || 1); },
+            });
+        }
+    });
+};
+withMotion(INTRO);
+withMotion(WAVE_SPEED_UP);
