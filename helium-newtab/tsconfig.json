{
    "compilerOptions": {
        "resolveJsonModule": true,
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "verbatimModuleSyntax": true,
        "types": ["chrome", "svelte"],
        "skipLibCheck": true
    },
    "include": ["src"]
}
